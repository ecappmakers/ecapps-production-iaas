      "unique": true
    },
    {
      "name": "email",
      "type": "VARCHAR(255)",
      "nullable": false,
      "unique": true
    },
    {
      "name": "password_hash",
      "type": "VARCHAR(255)",
      "nullable": false
    },
    {
      "name": "created_at",
      "type": "DATETIME",
      "nullable": false,
      "default": "CURRENT_TIMESTAMP"
    },
    {
      "name": "updated_at",
      "type": "DATETIME",
      "nullable": true,
      "default": "CURRENT_TIMESTAMP"
    },
    {
      "name": "is_active",
      "type": "BOOLEAN",
      "nullable": false,
      "default": true
